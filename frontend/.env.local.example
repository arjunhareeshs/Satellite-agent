# Copy to .env.local for local development.
#
# Empty / unset means "same origin, use the next.config.js dev proxy" — that
# is the default and works for `npm run dev` against a locally running
# backend on :8000. Set this explicitly for a production build or a backend
# on a different host, since next.config.js's rewrite only applies in dev.
NEXT_PUBLIC_API_URL=
