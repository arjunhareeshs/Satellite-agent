# TRINETRA environment configuration
# Copy to .env and fill in.  `.env` is gitignored.

# ---------------------------------------------------------------- LLM / VLM
# Development provider. Get a free key at https://console.groq.com/keys
# Leave empty to force the offline deterministic template parser.
GROQ_API_KEY=

# Local offline provider (llama.cpp / vLLM, OpenAI-compatible endpoint).
# Used when config/providers.yaml has active: "local"
LOCAL_VLM_ENDPOINT=http://localhost:8080/v1

# ---------------------------------------------------------------- PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trinetra
POSTGRES_USER=trinetra
POSTGRES_PASSWORD=trinetra_secure_password

# ---------------------------------------------------------------- Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---------------------------------------------------------------- Imagery
# Sentinel-2 L2A COGs (AWS open data, no auth required).
STAC_S2_ENDPOINT=https://earth-search.aws.element84.com/v1
STAC_S2_COLLECTION=sentinel-2-l2a

# Sentinel-1 RTC (Microsoft Planetary Computer, anonymous SAS signing).
STAC_S1_ENDPOINT=https://planetarycomputer.microsoft.com/api/stac/v1
STAC_S1_COLLECTION=sentinel-1-rtc
# Optional: raises MPC rate limits. Free at https://planetarycomputer.microsoft.com/account/request
PC_SDK_SUBSCRIPTION_KEY=

# Copernicus Data Space — used by 03b for sovereign provenance cross-reference.
# Search is unauthenticated; only direct CDSE download would need credentials.
CDSE_ODATA_ENDPOINT=https://catalogue.dataspace.copernicus.eu/odata/v1

# ---------------------------------------------------------------- Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
